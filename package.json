{
  "name": "token-by-token",
  "version": "0.1.0",
  "private": true,
  "description": "Build a tiny GPT from scratch in 7 days: animated lessons that show what happens inside a language model, one token at a time.",
  "license": "MIT",
  "keywords": [
    "llm",
    "transformer",
    "gpt",
    "attention",
    "education",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_LOADER_THREADS=1 NEXT_DIST_DIR=out next build",
    "start": "next start",
    "serve": "python3 -m http.server 3150 --directory out",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "test": "vitest run lib/engine",
    "pdf": "node scripts/make-pdf.mjs",
    "og": "node --no-warnings scripts/make-og.mjs",
    "gifs": "node scripts/record-gifs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "gpt-tokenizer": "^4.1.2",
    "lucide-react": "^1.78.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.65.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
